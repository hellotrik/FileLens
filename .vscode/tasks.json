{
    "version": "2.0.0",
    "tasks": [
        {
            "id": "filelens-xcodegen",
            "label": "FileLens: Generate Xcode Project",
            "type": "shell",
            "icon": {
                "id": "gear",
                "tooltip": "xcodegen generate"
            },
            "command": "xcodegen generate",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "id": "filelens-build-release",
            "label": "FileLens: Build Release",
            "type": "shell",
            "icon": {
                "id": "rocket",
                "tooltip": "Release → .release/arm64/Build/Products/Release/FileLens.app"
            },
            "dependsOn": ["filelens-xcodegen"],
            "command": "xcodebuild -project FileLens.xcodeproj -scheme FileLens -configuration Release -derivedDataPath ${workspaceFolder}/.release/arm64 -destination 'platform=macOS' ARCHS=arm64 ONLY_ACTIVE_ARCH=NO build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "id": "filelens-pack-arm64",
            "label": "FileLens: Pack DMG (arm64)",
            "type": "shell",
            "icon": {
                "id": "gift",
                "tooltip": "Release 编译并打 arm64 DMG → dist/"
            },
            "dependsOn": ["filelens-xcodegen"],
            "command": "./Scripts/pack.sh arm64",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "id": "filelens-clean",
            "label": "FileLens: Clean",
            "type": "shell",
            "icon": {
                "id": "refresh",
                "tooltip": "清除 .dev-build / .release / dist 等构建产物"
            },
            "command": "./Scripts/clean.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
